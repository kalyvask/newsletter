# Anthropic API Key (required for AI analysis)
ANTHROPIC_API_KEY=your_key_here

# Reddit API credentials (optional - for Reddit scraping)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=AIDeploymentMonitor/1.0

# Email configuration for newsletter delivery
# For Gmail: use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_EMAIL_TO=recipient@example.com
REPORT_EMAIL_FROM=

# Newsletter branding (optional — defaults to "AI Deployment Intelligence")
NEWSLETTER_TITLE=Your Newsletter Title
NEWSLETTER_FOOTER_LABEL=Your Newsletter
NEWSLETTER_FOOTER_LINK=https://your-newsletter-url.example.com

# Optional: override paths to your personal config (defaults: ./reading-list.json, ./voice.md)
# READING_LIST_PATH=
# VOICE_PROMPT_PATH=

# Optional: Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
